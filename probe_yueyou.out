{"code":0,"data":{"count":731,"list":[{"id":234912,"wapBookId":234912,"bookName":"仙道医王","authorName":"弄潮","bookPic":"https://cdn.p.yueyouxs.com/wap/234912/023c7914c3697a1a15e7ffb606ad0649.jpg","fullFlag":1,"group":0,"words":6308752,"copyrightName":"疯读-云霄文学","classify":11,"classifySecond":1100,"isFee":0,"unitCprice":0,"chapterCount":3011,"extChapterCount":0,"maxFreeCount":20,"extendstr":"第3011章  重返地球（大结局）\u003c:\u003e237923\u003c:\u003e男频/都市生活","extendstr2":"234913","latestChapterId":237923,"latestChapterName":"第3011章  重返地球（大结局）","createTime":"2022-01-28 10:02:12","updateTime":"2023-06-30 18:07:35","state":21,"classifyName":"男频","classifySecondName":"都市人生","intro":"借高利贷被沉河的陆寒，生死间获得上古传承，逆天崛起，驰骋都市。从此医术至强，武技通天，开启开挂人生……"},{"id":228618,"wapBookId":228618,"bookName":"极道仙尊","authorName":"剑风凛冽","bookPic":"https://cdn.p.yueyouxs.com/wap/228618/31987aba73519de8b0722a60c17b366a.jpg","fullFlag":1,"group":0,"words":2919591,"copyrightName":"逐浪","classify":11,"classifySecond":1101,"isFee":0,"unitCprice":0,"chapterCount":1267,"extChapterCount":0,"maxFreeCount":20,"extendstr":"第一千二百六十六章 无尽岁月前的隐秘\u003c:\u003e229885\u003c:\u003e男频/玄幻奇幻","extendstr2":"228619","latestChapterId":229885,"latestChapterName":"第一千二百六十六章 无尽岁月前的隐秘","createTime":"2021-02-02 15:19:46","updateTime":"2021-05-16 17:16:26","state":21,"classifyName":"男频","classifySecondName":"玄幻奇幻","intro":"苍茫世间，道统林立，万灵争渡，皆为长生。\n在这诸圣陨落的年代，绝世体质相继出世，翻覆乾坤。\n少年自微末中走出，一心所向，逆天崛起。\n即便举世皆敌，亦可举世无敌。"},{"id":199375,"wapBookId":26657,"bookName":"仙道至圣","authorName":"古陵","bookPic":"https://cdn.p.yueyouxs.com/wap/26657/6ae50385aa62f3fb6854f3cfbb9eb7e7.jpg","fullFlag":1,"group":1,"words":1385440,"copyrightName":"作客中文网","classify":11,"classifySecond":1102,"isFee":0,"unitCprice":0,"chapterCount":453,"extChapterCount":0,"maxFreeCount":20,"extendstr":"第453章：大结局（至圣）\u003c:\u003e199828\u003c:\u003e男频/武侠仙侠","extendstr2":"199376","latestChapterId":199828,"latestChapterName":"第453章：大结局（至圣）","createTime":"2019-02-26 18:08:31","updateTime":"2019-06-06 19:22:49","state":21,"classifyName":"男频","classifySecondName":"武侠仙侠","intro":"太初之末，九州动荡！三千位面遭劫，百族没落，人族先圣借此先机开创万古盛世，缔造文明。\r\n逝者如斯，岁月冉冉，事隔百万年，一位曾经弃武从文的清秀少年带着睿智的双眼依然踏出八百渭水，一心追求至圣道。不想，却是坠落重重迷局，惊起天宇之变……\r\n仙道迷漫，寰宇无圣，他又将如何在这乱世之中求得一线天机，问仙成圣？"},{"id":227203,"wapBookId":227203,"bookName":"仙武帝尊","authorName":"六界三道","bookPic":"https://cdn.p.yueyouxs.com/wap/227203/ad14d48feaf0f0aec8e42cd25a33508f.jpg","fullFlag":1,"group":0,"words":9355459,"copyrightName":"塔读文学","classify":11,"classifySecond":1102,"isFee":0,"unitCprice":0,"chapterCount":3365,"extChapterCount":0,"maxFreeCount":20,"extendstr":"第3365章 人间道\u003c:\u003e230568\u003c:\u003e男频/玄幻奇幻","extendstr2":"227204","latestChapterId":230568,"latestChapterName":"第3365章 人间道","createTime":"2020-12-17 11:53:33","updateTime":"2021-05-08 11:09:05","state":21,"classifyName":"男频","classifySecondName":"武侠仙侠","intro":"九千年前，仙武帝尊率领百万神将打入太古洪荒，却无一人归来，只有一缕真火遗留世间。\r\n九千年后，门派废徒叶辰，被赶出宗门，无以为家，机缘巧合之下偶得真火，再踏仙武之路。\r\n这是一个神魔仙佛并立的世界，这是一个诸天万域混乱的年代，叶辰的逆天征途，由此开始。"},{"id":231874,"wapBookId":231874,"bookName":"武道战神","authorName":"邪九幽","bookPic":"https://cdn.p.yueyouxs.com/wap/231874/c93ae2f9c282bb35c4014f2747c93fa5.jpg","fullFlag":1,"group":0,"words":3467210,"copyrightName":"塔读文学","classify":11,"classifySecond":1101,"isFee":0,"unitCprice":0,"chapterCount":1137,"extChapterCount":0,"maxFreeCount":20,"extendstr":"第1137章  大结局\u003c:\u003e233011\u003c:\u003e男频/玄幻奇幻","extendstr2":"231875","latestChapterId":233011,"latestChapterName":"第1137章  大结局","createTime":"2021-06-29 19:31:52","updateTime":"2021-06-29 19:37:47","state":21,"classifyName":"男频","classifySecondName":"玄幻奇幻","intro":"三年前，他收获了一株灵果，却被一位守山弟子抢夺。\r\n三年后，那位守山弟子成为了宗门内最耀眼的天才，而他却发现，被夺走的灵果，不过是他所获得的机缘的万分之一。\r\n从此他如彗星般崛起，开启一条神话般的逆天之路。"}]},"errors":[],"msg":"Success"}