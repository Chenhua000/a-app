{"code":0,"data":{"count":26,"list":[{"id":234323,"wapBookId":234323,"bookName":"北派盗墓笔记","authorName":"云峰","bookPic":"https://cdn.p.yueyouxs.com/wap/234323/745cf59ff0efbc505d4e6ede831067a6.jpg","fullFlag":0,"group":0,"words":4479074,"copyrightName":"六月小说","classify":11,"classifySecond":1107,"isFee":0,"unitCprice":0,"chapterCount":1855,"extChapterCount":0,"maxFreeCount":20,"extendstr":"第82章 还钱\u003c:\u003e236178\u003c:\u003e男频/悬疑灵异","extendstr2":"234324","latestChapterId":236178,"latestChapterName":"第82章 还钱","createTime":"2021-12-06 19:02:16","updateTime":"2026-11-07 22:51:01","state":21,"classifyName":"男频","classifySecondName":"悬疑灵异","intro":"【盗墓+悬疑+鉴宝】我是一个东北山村的穷小子，二十一世纪初，为了出人头地，我加入了一个北方派盗墓团伙。从南到北，江湖百态，三教九流，这么多年从少年混到了中年，酒量见长，岁月蹉跎，我曾接触过许许多多的奇人异事，各位如有兴趣，不妨搬来小板凳，听一听，一位盗墓贼的江湖见闻。"},{"id":234116,"wapBookId":234116,"bookName":"北派茅山笔记","authorName":"一颗猕猴桃","bookPic":"https://cdn.p.yueyouxs.com/wap/234116/b9c5425d07480149d5ee737f32bbfe83.jpg","fullFlag":1,"group":0,"words":2059808,"copyrightName":"漫步文学","classify":11,"classifySecond":1107,"isFee":0,"unitCprice":0,"chapterCount":961,"extChapterCount":0,"maxFreeCount":20,"extendstr":"第961章 如梦如幻\u003c:\u003e235077\u003c:\u003e男频/悬疑灵异","extendstr2":"234117","latestChapterId":235077,"latestChapterName":"第961章 如梦如幻","createTime":"2021-11-22 22:27:50","updateTime":"2022-10-31 16:00:36","state":21,"classifyName":"男频","classifySecondName":"悬疑灵异","intro":"我生来便浑身青紫，没有心跳，是一枚死胎。\r\n爷爷乃正统北茅传人，为了救我，不顾祖师爷祖训，以捉生替死的邪术之法，将我从阎王爷手中夺了出来。\r\n因此招来厄运，我被五仙拜鬼门彻底纠缠，不死不休。\r\n想活下去，我只能靠着一柄桃木剑，与阎王爷挣命！"},{"id":236030,"wapBookId":236030,"bookName":"南派寻龙手札","authorName":"一卷残篇","bookPic":"https://cdn.p.yueyouxs.com/wap/236030/4cf65d0133aa162e95110ec03b715019.jpg","fullFlag":1,"group":0,"words":1969722,"copyrightName":"奇迹文学","classify":11,"classifySecond":1107,"isFee":0,"unitCprice":0,"chapterCount":955,"extChapterCount":0,"maxFreeCount":20,"extendstr":"第955章 尘埃落定\u003c:\u003e236985\u003c:\u003e男频/悬疑灵异","extendstr2":"236031","latestChapterId":236985,"latestChapterName":"第955章 尘埃落定","createTime":"2022-05-05 15:40:15","updateTime":"2023-03-07 02:29:55","state":21,"classifyName":"男频","classifySecondName":"悬疑灵异","intro":"盗墓分南北，北派擅长用“技”分山甲，南派精通以“术”解丘门。初出茅庐遭人算计，师父舍命相救，自此我成了南派“土夫子”。\n令人闻风丧胆的潭王墓，万仞高崖上的架壑船棺，暗流汹涌的万象冢…数年间，出生入死，如履薄冰。\n摸金倒斗绝非易事，凶险重重，步步杀机，更令人防不胜防的是人心叵测，祸福参差……"},{"id":234521,"wapBookId":234521,"bookName":"南派风水师","authorName":"剑过龙门","bookPic":"https://cdn.p.yueyouxs.com/wap/234521/b9f5ec7492ba343ff820072341d8fe78.jpg","fullFlag":1,"group":0,"words":129717,"copyrightName":"阅友科技","classify":11,"classifySecond":1107,"isFee":0,"unitCprice":0,"chapterCount":65,"extChapterCount":0,"maxFreeCount":20,"extendstr":"第65章  消失（完）\u003c:\u003e234586\u003c:\u003e男频/悬疑灵异","extendstr2":"234522","latestChapterId":234586,"latestChapterName":"第65章  消失（完）","createTime":"2021-12-28 09:36:13","updateTime":"2022-02-22 14:40:16","state":21,"classifyName":"男频","classifySecondName":"悬疑灵异","intro":"三尺头，驾阴风，太阴位当中。\r\n黄鸾驾，寿青松，阳宅凶入宫。\r\n挥手血屠雨，撒豆万千兵……"},{"id":232792,"wapBookId":232792,"bookName":"妖孽小仙医","authorName":"苏派","bookPic":"https://cdn.p.yueyouxs.com/wap/232792/241f4a059621409668123f482d855074.jpg","fullFlag":1,"group":0,"words":3214784,"copyrightName":"梧桐中文网","classify":11,"classifySecond":1100,"isFee":0,"unitCprice":0,"chapterCount":1204,"extChapterCount":0,"maxFreeCount":20,"extendstr":"第1204章  番外4 幻境的恐怖\u003c:\u003e233996\u003c:\u003e男频/乡村生活","extendstr2":"232793","latestChapterId":233996,"latestChapterName":"第1204章  番外4 幻境的恐怖","createTime":"2021-09-06 16:31:39","updateTime":"2022-10-06 21:37:11","state":21,"classifyName":"男频","classifySecondName":"都市人生","intro":"小小村医陆言，竟让美女蜂拥而来，让权贵俯首臣称，到底有何魅力？\r\n\r\n（连载更新小提示：本书不是每天都更新，偶尔会隔天更，每次更新1章-2章不等，请读者大大耐心等待作者创作哟~~）"}]},"errors":[],"msg":"Success"}